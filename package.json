{
  "name": "@antora-supplemental/page-context",
  "version": "0.6.5",
  "description": "Asciidoctor/Antora extension: slim byline + page-* metadata, keyword index pages, HTML meta",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./antora": "./lib/antora.js"
  },
  "files": [
    "lib/**/*",
    "README.adoc",
    "CHANGELOG.adoc",
    "LICENSE",
    "antora-registry.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "keywords": [
    "antora",
    "antora-extension",
    "asciidoctor",
    "asciidoc",
    "extension",
    "page-attributes",
    "audience",
    "author",
    "metadata",
    "keywords"
  ],
  "homepage": "https://github.com/antora-supplemental/page-context",
  "bugs": {
    "url": "https://github.com/antora-supplemental/page-context/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antora-supplemental/page-context.git"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@antora/site-generator": ">=3.1.0"
  },
  "peerDependenciesMeta": {
    "@antora/site-generator": {
      "optional": true
    }
  },
  "devDependencies": {
    "@asciidoctor/core": "^3.0.4"
  },
  "packageManager": "pnpm@10.30.3"
}
